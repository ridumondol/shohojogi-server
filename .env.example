# Required database and security keys
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars

# Social Authentication: Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/users/oauth/google/callback

# Social Authentication: GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/users/oauth/github/callback

# Server and CORS configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# For multiple client origins:
# CLIENT_URLS=http://localhost:3000,https://your-domain.com

# Database options
MONGODB_DB_NAME=sheba_connect
MONGODB_MAX_POOL_SIZE=10
